      "source": [
        "# Restaurant Billing System\n",
        "\n",
        "food_bill = float(input(\"Enter Food Bill: \"))\n",
        "\n",
        "gst = food_bill * 0.05\n",
        "service = food_bill * 0.10\n",
        "\n",
        "total = food_bill + gst + service\n",
        "\n",
        "print(\"GST:\", gst)\n",
        "print(\"Service Charge:\", service)\n",
        "print(\"Total Bill:\", total)"
      ],
