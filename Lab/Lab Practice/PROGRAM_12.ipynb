      "source": [
        "# Mobile Recharge Billing\n",
        "\n",
        "amount = float(input(\"Enter Recharge Amount: \"))\n",
        "\n",
        "if amount >= 500:\n",
        "    cashback = 50\n",
        "else:\n",
        "    cashback = 20\n",
        "\n",
        "final = amount - cashback\n",
        "\n",
        "print(\"Cashback:\", cashback)\n",
        "print(\"Final Amount:\", final)"
      ],
