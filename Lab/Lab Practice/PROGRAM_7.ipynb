      "source": [
        "# Bank Interest Calculator\n",
        "\n",
        "p = float(input(\"Enter Principal: \"))\n",
        "r = float(input(\"Enter Rate: \"))\n",
        "t = float(input(\"Enter Time (years): \"))\n",
        "\n",
        "si = (p * r * t) / 100\n",
        "ci = p * ((1 + r / 100) ** t) - p\n",
        "\n",
        "print(\"Simple Interest:\", si)\n",
        "print(\"Compound Interest:\", ci)"
      ],
