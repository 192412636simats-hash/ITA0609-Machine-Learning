      "source": [
        "# Railway Ticket Fare Calculator\n",
        "\n",
        "fare = float(input(\"Enter Base Fare: \"))\n",
        "age = int(input(\"Enter Age: \"))\n",
        "\n",
        "if age < 12:\n",
        "    fare = fare * 0.5\n",
        "elif age >= 60:\n",
        "    fare = fare * 0.7\n",
        "\n",
        "print(\"Ticket Fare = ₹\", fare)"
      ],
